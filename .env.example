# Copy to .env and adjust. Never commit .env.
# Host directory with the files to share (mounted read-only into the container)
SHARER_FILES=/srv/media
# Public address friends will use (pre-fills the setup page)
SHARER_BASE_URL=https://share.example.com
# Where the container's port is published on the host (default 8080 on all interfaces).
# Behind a reverse proxy, bind to localhost only, e.g. 127.0.0.1:8002
SHARER_BIND=8080
